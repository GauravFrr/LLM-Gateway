# Gateway Server Config
HOST=0.0.0.0
PORT=8000
PROMETHEUS_SCRAPE_INTERVAL=5s # set to 2s for live dashboards, 15s during high throughput tests


# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama config
OLLAMA_BASE_URL=http://localhost:11434

# Admin Config (for later phases, placeholder)
ADMIN_API_KEY=admin_secret_key_here
