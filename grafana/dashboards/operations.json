          "legendFormat": "p95 Latency (ms)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(llm_gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "range": true,
          "refId": "C"
